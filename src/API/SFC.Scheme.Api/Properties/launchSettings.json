{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "SFC.Scheme": {
      "commandName": "Project",
      "launchBrowser": true,
      "launchUrl": "swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://+:7866;http://+:7865",
        "ASPNETCORE_HTTPS_PORT": "7866",
        "ConnectionStrings__Database": "Server=127.0.0.1,1433;Database=Scheme;User Id=sfc;Password=Test1234!;TrustServerCertificate=True;",
        "ConnectionStrings__Hangfire": "Server=127.0.0.1,1433;Database=Hangfire;User Id=sfc;Password=Test1234!;TrustServerCertificate=True;",
        "ConnectionStrings__RabbitMq": "rabbitmq://localhost:5672",
        "ConnectionStrings__Redis": "localhost:6379",
        "Endpoints__Identity__Uri": "https://localhost:7266",
        "Endpoints__Player__Uri": "https://localhost:7366",
        "Endpoints__Team__Uri": "https://localhost:7566",
        "Kestrel__Certificates__Default__Path": "C:/SFC/Configurations/certificates/sfc-scheme/sfc-scheme.pfx",
        "Kestrel__Certificates__Default__Password": "Test1234!"
      },
      "dotnetRunMessages": true,
      "applicationUrl": "https://localhost:7866;http://localhost:7865",
      "httpPort": 7865,
      "useSSL": true,
      "sslPort": 7866,
      "nativeDebugging": true
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": true,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/swagger",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://+:7866;http://+:7865",
        "ASPNETCORE_HTTPS_PORT": "7866"
      },
      "mycontainer": "sfc-scheme",
      "DockerfileRunArguments": "--network sfc-network --volume C:/SFC/Configurations/certificates/sfc-scheme/sfc-scheme.pfx:/https/sfc-scheme.pfx",
      "httpPort": 7865,
      "useSSL": true,
      "sslPort": 7866,
      "containerName": "sfc-scheme"
    }
  }
}